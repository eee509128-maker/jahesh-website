rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /test/{docId} {
      allow read, write: if true;
    }
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }
    match /tools/{toolId} {
      allow read: if true;
      allow write: if true;
    }
    match /chats/{chatId} {
      allow read: if true;
      allow write: if true;
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
    match /licenses/{licenseId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
